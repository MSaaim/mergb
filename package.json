{
  "name": "mergb",
  "version": "1.0.0",
  "description": "MeRGB keyboard control app for macOS and Windows",
  "main": "main.js",
  "author": "iVector Academy",
  "scripts": {
    "start": "electron .",
    "rebuild": "npx @electron/rebuild -f -w node-hid -w uiohook-napi",
    "postinstall": "npx @electron/rebuild -f -w node-hid -w uiohook-napi",
    "dist": "electron-builder --mac --arm64",
    "dist:win": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.ivectoracademy.mergb",
    "productName": "MeRGB",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-hid/**",
      "node_modules/usb/**",
      "node_modules/uiohook-napi/**",
      "**/*.node"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "MSaaim",
      "repo": "mergb"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-hid": "^3.1.0",
    "uiohook-napi": "^1.5.5",
    "usb": "^2.17.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0"
  }
}
